[Unit]
Description=PGPC Library Laravel scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pgpc-lib
ExecStart=/usr/bin/php8.4 /opt/pgpc-lib/artisan schedule:work
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
